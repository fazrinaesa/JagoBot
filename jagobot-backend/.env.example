# ─── DATABASE (Supabase Postgres) ───
# Ambil dari Supabase Dashboard → Connect / Settings → Database
# DATABASE_URL  : koneksi via pooler (port 6543, pgbouncer=true) — untuk runtime
# DIRECT_URL    : koneksi langsung (port 5432) — untuk prisma migrate / db push
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── SUPABASE (Storage, dipakai userController.ts) ───
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon key>"
SUPABASE_SERVICE_KEY="<service_role key>"

# ─── AUTH / ENCRYPTION ───
JWT_SECRET="<string acak minimal 32 karakter>"
AI_CONFIG_SECRET="<random secret, minimum 32 characters>"
FRONTEND_URL="http://localhost:5177"

# ─── TELEGRAM WEBHOOK ───
# Public HTTPS origin of this backend, e.g. https://api.example.com
TELEGRAM_WEBHOOK_BASE_URL="https://<your-public-backend-host>"


# ─── AI / LLM ───
GEMINI_API_KEY="<gemini api key>"
NINEROUTER_API_KEY="<opsional>"
NINEROUTER_BASE_URL="<opsional>"
NINEROUTER_CHAT_MODEL="<opsional>"
NINEROUTER_EMBED_MODEL="<opsional>"

# ─── EMAIL (nodemailer) ───
EMAIL_USER="<email smtp>"
EMAIL_PASS="<password / app password>"

# ─── GOOGLE SHEETS INTEGRATION (opsional) ───
GOOGLE_CLIENT_ID="<opsional>"
GOOGLE_CLIENT_SECRET="<opsional>"
GOOGLE_REDIRECT_URI="<opsional>"
SHEETS_ENCRYPTION_KEY="<opsional>"

# ─── SERVER ───
PORT=5006
