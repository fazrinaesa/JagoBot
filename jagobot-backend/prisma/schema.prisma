generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  nama_toko    String
  email        String   @unique
  password     String
  nama_lengkap String?
  whatsapp     String?
  alamat       String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  bots         Bot[]
  subscriptions Subscription[]
  paymentProofs PaymentProof[]
}

model Bot {
  id              Int             @id @default(autoincrement())
  userId          Int
  nama_bot        String
  personality     String          @default("Ramah")
  whatsapp_linked Boolean         @default(false)
  instructions    String?
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatLogs        ChatLog[]
  knowledgeBases  KnowledgeBase[]
  sheetsConnections GoogleSheetsConnection[]
}

model KnowledgeBase {
  id          Int             @id @default(autoincrement())
  botId       Int
  nama_sumber String
  file_path   String?
  status      String          @default("processing")
  createdAt   DateTime        @default(now())
  isi_teks    String?
  tipe_sumber String?         @default("file")
  chunks      DocumentChunk[]
  bot         Bot             @relation(fields: [botId], references: [id])
  // ✅ TAMBAHKAN BARIS INI
  @@unique([botId, nama_sumber])
}

model DocumentChunk {
  id              Int                    @id @default(autoincrement())
  knowledgeBaseId Int
  content         String
  embedding       Unsupported("vector")?
  knowledgeBase   KnowledgeBase          @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ChatLog {
  id               Int      @id @default(autoincrement())
  botId            Int
  aiResponse       String   // Sesuai kolom di Supabase
  createdAt        DateTime @default(now()) // Sesuai kolom di Supabase
  platform         String   // Sesuai kolom di Supabase
  userMessage      String   // Sesuai kolom di Supabase
  response_time_ms Int?     // Waktu respon AI dalam milidetik (nullable untuk data lama)
  tokenCount       Int?     // Token usage for this chat (for quota metering)
  bot              Bot      @relation(fields: [botId], references: [id])
}

// ─── PAYMENT & SUBSCRIPTION MODELS ───

model Subscription {
  id            Int      @id @default(autoincrement())
  userId        Int
  planType      String   // "basic" | "whatsapp" | "telegram" | "whatsapp+telegram"
  status        String   @default("inactive") // "active" | "inactive" | "expired" | "pending"
  startDate     DateTime?
  endDate       DateTime?
  dailyTokenQuota Int    @default(5000)  // daily token limit
  tokensUsedToday Int  @default(0)
  lastQuotaReset  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentProofs PaymentProof[]
}

model PaymentProof {
  id            Int      @id @default(autoincrement())
  userId        Int
  subscriptionId Int?
  amount        Int      // amount in IDR
  proofUrl      String?  // path to uploaded screenshot
  status        String   @default("pending") // "pending" | "approved" | "rejected"
  adminNote     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
  subscription  Subscription? @relation(fields: [subscriptionId], references: [id])
}

// ─── GOOGLE SHEETS INTEGRATION ───

model GoogleSheetsConnection {
  id            Int      @id @default(autoincrement())
  botId         Int
  spreadsheetId String
  sheetName     String   @default("Sheet1")
  pollIntervalMin Int   @default(60) // polling interval in minutes
  lastSyncedAt  DateTime?
  isActive      Boolean  @default(true)
  oauthToken    String   // encrypted OAuth2 token
  refreshToken  String   // encrypted refresh token
  tokenExpiry   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bot           Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
}


