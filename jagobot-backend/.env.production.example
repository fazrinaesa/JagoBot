# ── JagoBot Backend — contoh environment PRODUKSI ──
# Salin nilai asli lewat panel hosting (Environment Variables).
# JANGAN commit file .env berisi nilai asli.

# Database (dari Kroombox: Databases → kredensial)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5433/DBNAME?schema=public&sslmode=disable"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5433/DBNAME?schema=public&sslmode=disable"

# Server
PORT=5000
NODE_ENV=production
FRONTEND_URL="https://jagobot.jagoai.dev"

# Keamanan
JWT_SECRET="ganti-dengan-string-acak-panjang"
AI_CONFIG_SECRET="ganti-dengan-string-acak-panjang"
SUPER_ADMIN_EMAIL="email-admin-anda@domain.com"

# AI
GEMINI_API_KEY=""
GEMINI_CHAT_MODELS="gemini-2.0-flash"
GEMINI_TIMEOUT_MS=30000

# Pinecone (opsional, hanya jika memakai vector store eksternal)
PINECONE_API_KEY=""
PINECONE_ENVIRONMENT=""
PINECONE_INDEX_NAME=""

# Supabase (opsional — tidak dipakai lagi; avatar & bukti transfer via CDN Kroombox)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_KEY=""

# CDN Kroombox — wajib untuk upload avatar & bukti transfer di produksi
CDN_BASE_URL="https://cdn.kroombox.com/api/bridge"
CDN_API_KEY=""
CDN_PROJECT_ID=""
CDN_TIMEOUT_MS=30000

# Email reset password (opsional)
EMAIL_USER=""
EMAIL_PASS=""

# Google Sheets (opsional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
